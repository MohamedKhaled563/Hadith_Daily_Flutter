<?xml version="1.0" encoding="utf-8"?>
<!-- The pre-adaptive (API 21-25) launcher icon: the emerald ground and the
     brand glyph baked into one square, since there is no adaptive mask to
     compose them.

     This replaces five byte-identical per-density copies of a generic gold
     heart — they were vector drawables, so the densities never differed and
     only the dp header did. One anydpi vector covers every density; API 26+
     picks mipmap-anydpi-v26 and its adaptive layers instead.

     Geometry matches drawable/ic_launcher_foreground.xml; see the note there
     about the 512 grid and the safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <path
        android:fillColor="#15362B"
        android:pathData="M0,0h512v512h-512z"/>
    <path
        android:strokeColor="#D9B44A"
        android:strokeWidth="30"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M256,176 C226,120 152,112 118,156 C88,196 102,252 142,294 C178,332 222,368 256,398 C290,368 334,332 370,294 C410,252 424,196 394,156 C360,112 286,120 256,176 Z"/>
    <path
        android:strokeColor="#D9B44A"
        android:strokeWidth="20"
        android:strokeLineCap="round"
        android:pathData="M256,384 C256,328 258,266 256,212"/>
    <path
        android:fillColor="#D9B44A"
        android:pathData="M250,326 C210,314 174,280 164,238 C206,246 240,278 250,326 Z"/>
    <path
        android:fillColor="#D9B44A"
        android:pathData="M262,290 C302,278 338,244 348,202 C306,210 272,242 262,290 Z"/>
    <path
        android:fillColor="#D9B44A"
        android:pathData="M256,214 C238,188 240,154 256,134 C272,154 274,188 256,214 Z"/>
</vector>
