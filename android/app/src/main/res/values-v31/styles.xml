<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 replaced the plain windowBackground starting window with the
         SplashScreen API, which draws the launcher icon on its own background
         and ignores @drawable/launch_background. Pointing it at the same
         emerald keeps the cold start identical across OS versions. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#FF15362B</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
