rules_version = '2';

// Phase 1: deny-by-default, plus read-only access to the two collections
// that phase 2 (content migration) populated. Nothing here lets a client
// write anything to them — hadiths/dailyMessages are written only by the
// admin import scripts, which use the Admin SDK and therefore never go
// through these rules at all.
//
// Phase 4 adds users/ below and moderator/admin clauses on
// communityMessages. Phase 5 adds settings/ (the delivery-mode toggle) and
// a narrow timesShown/lastShownAt update on dailyMessages' and
// communityMessages' pool entries — see the daily delivery engine
// (DailyTipService). Phase 6 lets a moderator/admin — from the dashboard,
// using the ordinary client SDK — edit dailyMessages (e.g. `order`) and
// flip settings/deliveryMode; both were client SDK-write:false before,
// since nothing needed to write them yet. Phase 6's bulk-add page lets a
// moderator/admin also *create* dailyMessages docs, replacing the
// Google-Sheets-bridge idea from the original roadmap. Phase 7 adds a real
// per-user likes/ subcollection, replacing the interim likeCount mechanism
// from phase 3 (that narrow ±1 rule stays as a secondary safety net —
// harmless on its own, and simpler than trying to cross-validate it
// against the subcollection write within the same rules evaluation).
// Phase 10 adds size/range validation on communityMessages and users
// writes — see tool/verify_rules.py for a repeatable check of the allow/
// deny behaviour documented in each match block below.
//
// Phase 11: role checks below used to read request.auth.token.role — a
// custom claim only the Admin SDK can set, which meant every role change
// needed a terminal script even though users/{uid}.role already sits
// right there in Firestore. roleOf()/isModerator()/isAdmin() below read
// that field instead (one extra get() per check, well within Spark's free
// read quota for an app this size), so granting a role becomes an ordinary
// Firestore write an admin can make from the dashboard — see the
// users/{uid} update rule and lib/features/dashboard/users_page.dart.
// tool/set_role.py still exists for bootstrapping the very first admin,
// since someone has to be able to promote before anyone can use the UI.
// Phase 12 adds notificationMessages/ — a small moderator/admin-curated
// pool for scheduled local notifications (NotificationScheduler picks
// per-device, no server push involved). Phase 14 lets a moderator/admin
// create a communityMessages doc directly (any status) from the
// dashboard's Excel bulk-edit tab, alongside the existing author-submits-
// pending path. Phase 16 narrows dailyMessages/notificationMessages update
// and delete from isModerator() to isAdmin() — a moderator's Excel bulk
// tool went create-only, and these two collections have no other
// moderator-facing edit path, so this closes the gap where a moderator
// could still write directly against the rules even though the dashboard
// UI no longer offers it. communityMessages is untouched: its
// isModerator() update/delete is what the pending-queue approve/reject
// workflow runs on, a legitimate per-item moderator duty unrelated to the
// bulk tool. Phase 17 removes the docId column from the bulk tool's upload
// template entirely (for both roles) — BulkAddPage now only ever produces
// create writes (BulkAddPage._collect*Creates), so the update/delete rules
// below are exercised only by each collection's own per-item edit path,
// never by the bulk tool. The settings/deliveryMode toggle that phases 5
// and 6 above introduced is gone — per-date scheduling
// (settings/dailyMessageSchedule) replaced it, and tool/
// set_delivery_mode.py went with it — so settings/{settingId} below now
// covers only notificationMode and dailyMessageSchedule.
service cloud.firestore {
  match /databases/{database}/documents {

    function roleOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('role', 'user');
    }
    function isModerator() {
      return request.auth != null && roleOf(request.auth.uid) in ['moderator', 'admin'];
    }
    function isAdmin() {
      return request.auth != null && roleOf(request.auth.uid) == 'admin';
    }
    // Whether request.auth's own like doc exists once this request's writes
    // are applied — existsAfter() sees a transaction's own prior writes, so
    // this reflects CommunityService.toggleLike's real outcome rather than
    // being an independent, spoofable claim.
    function likeExistsAfter(messageId) {
      return existsAfter(/databases/$(database)/documents/communityMessages/$(messageId)/likes/$(request.auth.uid));
    }
    // Same idea as likeExistsAfter() above, for dailyMessages' own likes/
    // subcollection (MessageLikeService.toggleLike) — dailyMessages didn't
    // have a per-user like mechanism at all before this, so there's no
    // interim likeCount-only clause to preserve here, unlike communityMessages.
    function dailyMessageLikeExistsAfter(messageId) {
      return existsAfter(/databases/$(database)/documents/dailyMessages/$(messageId)/likes/$(request.auth.uid));
    }

    match /hadiths/{hadithId} {
      allow read: if true;
      allow write: if false;
    }

    // Three things are allowed here, so this is an OR:
    //   1. a moderator/admin (the dashboard), changing anything — covers
    //      both editing (order, text, ...) and phase 6's bulk-add create
    //   2. ANY signed-in device that just picked this as its own daily
    //      tip, but only ever moving `timesShown` up by exactly one and
    //      stamping `lastShownAt` — phase 5's delivery engine.
    // Phase 16: a moderator may only ever create here (the dashboard's bulk
    // tool gives them an empty template, never the existing rows) — editing
    // or deleting an existing message is admin-only from this point on,
    // matching the dashboard's BulkAddPage role split. The any-signed-in-
    // device timesShown/lastShownAt clause is unrelated (phase 5's delivery
    // engine) and stays open to every signed-in device, not just staff.
    match /dailyMessages/{messageId} {
      allow read: if true;
      allow create: if isModerator();
      allow update: if isAdmin()
                  || (request.auth != null
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['timesShown', 'lastShownAt'])
                      && request.resource.data.timesShown
                           == resource.data.get('timesShown', 0) + 1)
                  // Phase 19: ANY signed-in reader, but only ever moving
                  // `likeCount` by exactly one in the direction their own
                  // likes/{uid} doc actually moved in this same transaction
                  // — see MessageLikeService.toggleLike and the
                  // communityMessages equivalent above.
                  || (request.auth != null
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['likeCount'])
                      && ((request.resource.data.likeCount
                             == resource.data.get('likeCount', 0) + 1
                           && dailyMessageLikeExistsAfter(messageId))
                          || (request.resource.data.likeCount
                                == resource.data.get('likeCount', 0) - 1
                              && !dailyMessageLikeExistsAfter(messageId))));
      allow delete: if isAdmin();

      // Phase 19: one doc per user who has liked this message, id = their
      // uid — mirrors communityMessages/{messageId}/likes below. Fixes the
      // daily-message like button, which previously only lived in memory on
      // HadithRepository and never left the device.
      match /likes/{uid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null
                    && request.auth.uid == uid;
        allow update: if false;
      }
    }

    // Phase 12: a small curated pool a moderator/admin manages from the
    // dashboard's "رسائل التنبيه" tab. NotificationScheduler picks from the
    // `active` ones — public read since any signed-in device needs it to
    // schedule its own local notifications; only a moderator/admin writes.
    // Phase 16: same moderator-creates/admin-edits split as dailyMessages
    // above, for the same reason — this pool has no individual moderator
    // workflow of its own (unlike communityMessages' pending queue), so
    // there's nothing legitimate for a moderator to update or delete here.
    match /notificationMessages/{messageId} {
      // Public read, matching dailyMessages and settings above.
      //
      // This was `request.auth != null`, which was fine while the app had a
      // sign-in wall. It no longer does, and logcat on a guest device shows
      // exactly what that costs: the scheduler's query fails
      // PERMISSION_DENIED and every guest falls back to the small bundled
      // reminder pool instead of the curated one a moderator maintains.
      //
      // Nothing here is sensitive — it is a handful of short, admin-written
      // nudges that get shown to everyone anyway, as notifications.
      allow read: if true;
      allow create: if isModerator()
                  && request.resource.data.text is string
                  && request.resource.data.text.size() > 0
                  && request.resource.data.text.size() <= 300;
      allow update: if isAdmin()
                  && request.resource.data.text is string
                  && request.resource.data.text.size() > 0
                  && request.resource.data.text.size() <= 300;
      allow delete: if isAdmin();
    }

    // Phase 15: a moderator's Excel bulk-edit (bulk_add_page.dart) that
    // touches more than kBulkChangeThreshold items gets staged here instead
    // of writing dailyMessages/communityMessages/notificationMessages
    // directly — an admin reviews it from the dashboard's "طلبات المراجعة"
    // tab (bulk_change_requests_page.dart) and approving replays the staged
    // writes through the ordinary rules above. This collection only gates
    // *when* those writes happen; it never bypasses their own rules.
    // A moderator can create their own request and read it back to see its
    // status; only an admin can decide it (approve/reject) or delete it.
    match /bulkChangeRequests/{requestId} {
      allow read: if isAdmin()
                  || (isModerator()
                      && resource.data.submittedByUid == request.auth.uid);
      allow create: if isModerator()
                  && request.resource.data.submittedByUid == request.auth.uid
                  && request.resource.data.status == 'pending';
      allow update: if isAdmin()
                  && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'reviewedByUid', 'reviewedAt', 'reviewNote'])
                  && request.resource.data.status in ['approved', 'rejected'];
      allow delete: if isAdmin();
    }

    // Public read; a moderator/admin is the only client allowed to write —
    // covers the notification-mode flag, dailyMessageConfig's
    // messagesPerDay (how many messages a day carries), and
    // dailyMessageSchedule's per-date pins — the last two both set from
    // DailyMessageSchedulePage.
    //
    // dailyMessageConfig is the one doc here whose value every device acts
    // on numerically, so it gets a range check rather than trusting each
    // client to clamp it (DailyTipService.maxMessagesPerDay does clamp, but
    // that is a client-side guard, not an authorization one). The other
    // settings docs are unvalidated as before. Note create/update carry the
    // check while delete cannot — request.resource is null on a delete, so
    // the condition would error out and deny it outright.
    function validDailyMessageConfig() {
      return request.resource.data.messagesPerDay is int
          && request.resource.data.messagesPerDay >= 1
          && request.resource.data.messagesPerDay <= 10;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isModerator()
                  && (settingId != 'dailyMessageConfig'
                      || validDailyMessageConfig());
      allow delete: if isModerator();
    }

    // Phase 4: one doc per signed-in user, id = their uid. Phase 11 lets an
    // admin change `role` here too — see the update rule below — which is
    // what makes it the actual source of truth roleOf() reads, not just a
    // display mirror anymore.
    match /users/{uid} {
      allow read: if request.auth.uid == uid || isModerator();

      allow create: if request.auth.uid == uid
                  && request.resource.data.keys().hasOnly(
                       ['displayName', 'email', 'createdAt'])
                  && request.resource.data.displayName is string
                  && request.resource.data.displayName.size() <= 100;

      // Two unrelated things, so an OR:
      //   1. the account owner, renaming themselves — never touches role.
      //   2. an existing admin, changing someone ELSE's role to one of the
      //      three valid values. Never their own — uid != request.auth.uid
      //      stops an admin from fat-fingering themselves out of the role
      //      with nobody else around to undo it; another admin (or the
      //      bootstrap script) can always fix a mistaken grant instead.
      allow update: if (request.auth.uid == uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['displayName'])
                        && request.resource.data.displayName is string
                        && request.resource.data.displayName.size() <= 100)
                  || (isAdmin()
                      && uid != request.auth.uid
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['role'])
                      && request.resource.data.role in ['user', 'moderator', 'admin']);

      // Phase 18: lets an admin remove another account's users/{uid}
      // record from the dashboard's "المستخدمون" tab — same
      // uid != request.auth.uid guard as the role update above, so an
      // admin can't lock themselves out with nobody around to undo it.
      // This only ever deletes the Firestore profile/role doc, never the
      // underlying Firebase Auth account (that needs the Admin SDK, which
      // nothing in this client-only app has access to) — the person can
      // still sign in afterward, just as a plain 'user' (roleOf() falls
      // back to 'user' when this doc is missing), and the create rule
      // above lets them recreate this doc the ordinary way if they do.
      // Two cases, so an OR:
      //   1. an admin removing someone ELSE's record from the dashboard —
      //      the original clause, with its uid != request.auth.uid guard so
      //      an admin can't lock themselves out with nobody around to undo
      //      it.
      //   2. the account owner, as part of deleting their own account
      //      (AccountDeletionService). Play's Data Deletion policy and App
      //      Store 5.1.1(v) both require this to be possible from inside the
      //      app, and with no Cloud Functions on the Spark plan the client
      //      is the only thing that can do it.
      allow delete: if (isAdmin() && uid != request.auth.uid)
                  || request.auth.uid == uid;
    }

    // Phase 13: normalized-display-name uniqueness registry. Doc id is the
    // display name lowercased/trimmed by the client; the value is just
    // {uid}. Public read so the sign-up screen can check availability
    // before an account even exists — users/{uid} itself can't be read
    // pre-auth, which is why this lives as its own collection instead of
    // querying users/ by displayName. Create is restricted to the very
    // account claiming the name, and update/delete are blocked outright,
    // so a name that's already claimed can never be overwritten — that
    // split (rather than a transaction) is what closes the race between
    // two sign-ups claiming the same name at once: whichever create lands
    // first wins, the second is evaluated as an update against an
    // already-existing doc and denied.
    match /usernames/{nameKey} {
      allow read: if true;
      allow create: if request.auth != null
                  && request.resource.data.keys().hasOnly(['uid'])
                  && request.resource.data.uid == request.auth.uid;
      // Update stays closed — that is what makes the create-only claim a
      // race-free lock (see above). Delete is open to the account that holds
      // the name, and only to it: deleting an account has to release its
      // display name, or the name stays claimed forever by a user who no
      // longer exists. The `resource.data.uid == request.auth.uid` guard is
      // what keeps this from becoming a way to steal a name someone else
      // holds.
      allow update: if false;
      allow delete: if request.auth != null
                  && resource.data.uid == request.auth.uid;
    }

    match /communityMessages/{messageId} {
      // Public once approved; the author can always see their own
      // (including while still pending); moderators/admins can see
      // everything, which is what makes the pending queue possible.
      allow read: if resource.data.status == 'approved'
                  || request.auth.uid == resource.data.authorUid
                  || isModerator();

      // Two unrelated things, so an OR:
      //   1. an ordinary signed-in author, submitting for review — must be
      //      signed in (this app has no anonymous path at all), must claim
      //      authorship truthfully, and can only ever be created pending —
      //      a client cannot create a message that's already approved.
      //      Phase 10 adds the size/range checks: nothing here stops one
      //      account from spamming the pending queue with many submissions
      //      (that needs a counting read rules can't cheaply do, or a Cloud
      //      Function this project deliberately doesn't have), but it does
      //      stop any single submission from being pathologically large or
      //      aimed at a hadith number that doesn't exist.
      //   2. a moderator/admin, adding a message directly from the
      //      dashboard's Excel bulk-edit tab — trusted the same way their
      //      update access already is below, so no status/authorUid
      //      constraint; still worth keeping the size/range validation so a
      //      bad row in the sheet can't write garbage.
      allow create: if (request.auth != null
                        && request.resource.data.authorUid == request.auth.uid
                        && request.resource.data.status == 'pending'
                        && request.resource.data.likeCount == 0
                        && request.resource.data.message is string
                        && request.resource.data.message.size() > 0
                        && request.resource.data.message.size() <= 2000
                        && request.resource.data.authorName is string
                        && request.resource.data.authorName.size() <= 100
                        && request.resource.data.hadithNumber is int
                        && request.resource.data.hadithNumber >= 1
                        && request.resource.data.hadithNumber <= 42)
                  || (isModerator()
                      && request.resource.data.message is string
                      && request.resource.data.message.size() > 0
                      && request.resource.data.message.size() <= 2000
                      && request.resource.data.authorName is string
                      && request.resource.data.authorName.size() <= 100
                      && request.resource.data.hadithNumber is int
                      && request.resource.data.hadithNumber >= 1
                      && request.resource.data.hadithNumber <= 42
                      && request.resource.data.status in ['pending', 'approved', 'rejected']);

      // Four unrelated things are allowed to update a message, so this is
      // an OR of four independent conditions:
      //   1. the author, editing their own still-pending submission
      //   2. a moderator/admin, changing anything — this is the approve/
      //      reject/edit action; no field restriction, since a moderator is
      //      trusted the way the app's own client code isn't
      //   3. ANY signed-in reader, but only ever moving `likeCount` by
      //      exactly one in either direction — this used to be the *only*
      //      mechanism (phase 3); phase 7 below adds the real per-user
      //      likes/ subcollection as the actual source of truth for "have
      //      I liked this", and CommunityService now moves this counter
      //      only from inside the same transaction that writes the
      //      subcollection doc. This clause is tied to that subcollection
      //      write via existsAfter() — the counter can only move in the
      //      direction the requester's own likes/{uid} doc actually moved
      //      in this same transaction, so calling this update on its own
      //      (without truly toggling a like) is denied, not just capped
      //      to ±1 as before.
      //   4. ANY signed-in device, but only ever moving `timesShown` up by
      //      exactly one and stamping `lastShownAt` — phase 5's delivery
      //      engine, only ever applies to an approved message since that's
      //      the only status the pool draws from (now enforced here, not
      //      just documented).
      allow update: if (request.auth.uid == resource.data.authorUid
                        && resource.data.status == 'pending'
                        && request.resource.data.message is string
                        && request.resource.data.message.size() > 0
                        && request.resource.data.message.size() <= 2000)
                  || isModerator()
                  || (request.auth != null
                      && resource.data.status == 'approved'
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['likeCount'])
                      && ((request.resource.data.likeCount
                             == resource.data.likeCount + 1
                           && likeExistsAfter(messageId))
                          || (request.resource.data.likeCount
                                == resource.data.likeCount - 1
                              && !likeExistsAfter(messageId))))
                  || (request.auth != null
                      && resource.data.status == 'approved'
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['timesShown', 'lastShownAt'])
                      && request.resource.data.timesShown
                           == resource.data.get('timesShown', 0) + 1);

      // Was pending-only for the author. Widened to any status: an author
      // may withdraw their own contribution, and account deletion has to be
      // able to remove everything they ever posted — which is the option
      // chosen for this app over anonymising in place.
      //
      // Note what this does NOT reach: the likes/ subcollection under a
      // deleted post. Firestore does not cascade, and the rule below only
      // lets a like's own owner delete it, so other readers' like docs are
      // orphaned rather than removed. They carry no data about the deleted
      // author — the doc id is the *liker's* uid — so this is a tidiness
      // problem for a moderator, not a privacy one.
      allow delete: if request.auth.uid == resource.data.authorUid
                  || isModerator();

      // Phase 7: one doc per user who has liked this message, id = their
      // uid — its mere existence *is* "have I liked this", checked by uid
      // rather than a per-device local cache, which is what fixes the
      // "same device, cleared storage, likes twice" gap the interim
      // mechanism above couldn't close. Only its own owner may create or
      // delete it (like / unlike); nobody updates a like, there's nothing
      // in it to change.
      match /likes/{uid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null
                    && request.auth.uid == uid;
        allow update: if false;
      }
    }

    // A signed-in user's message from the settings drawer's "تواصل معنا
    // واقترح فكرة" sheet — visible to a moderator/admin from the
    // dashboard's "تواصل معنا" tab. No public read: this is a one-way
    // mailbox, not a community feed, so only the reviewing side needs
    // access to it.
    match /feedbackMessages/{messageId} {
      // Moderators read the mailbox; an author can read only their own, which
      // is what lets AccountDeletionService query for them by authorUid
      // before deleting them.
      allow read: if isModerator()
                || (request.auth != null
                    && resource.data.authorUid == request.auth.uid);
      allow create: if request.auth != null
                  && request.resource.data.authorUid == request.auth.uid
                  && request.resource.data.message is string
                  && request.resource.data.message.size() > 0
                  && request.resource.data.message.size() <= 2000
                  && request.resource.data.userName is string
                  && request.resource.data.userName.size() <= 100
                  && request.resource.data.userEmail is string
                  && request.resource.data.userEmail.size() <= 200
                  && request.resource.data.read == false;
      // A moderator/admin toggling `read` after reviewing it, or deleting
      // it outright — no author-side edit or delete, since this is a
      // one-way mailbox, not a message the sender manages afterward.
      allow update: if isModerator()
                  && request.resource.data.diff(resource.data)
                       .affectedKeys().hasOnly(['read']);
      // A moderator clearing the mailbox, or the author removing their own
      // message as part of deleting their account — the feedback doc carries
      // their name and email, so it cannot survive the account.
      allow delete: if isModerator()
                  || (request.auth != null
                      && resource.data.authorUid == request.auth.uid);
    }

    // Reader-filed reports on an already-approved community message.
    //
    // App Store guideline 1.2 requires a way to report objectionable content
    // in any app carrying user-generated content. The pending/approved queue
    // covers intake; nothing covered a post that is already live.
    //
    // Doc id is `<postId>_<uid>`, which is what makes a report idempotent
    // per reader — the rule below enforces that the id really does belong to
    // the caller, so nobody can file a report in someone else's name or
    // stuff the count by writing many docs.
    match /contentReports/{reportId} {
      // Only the reviewing side reads these. A reader learning who else
      // objected to a post is a way to start an argument, not to moderate.
      allow read: if isModerator();

      allow create: if request.auth != null
                  && reportId == request.resource.data.postId + '_' + request.auth.uid
                  && request.resource.data.reporterUid == request.auth.uid
                  && request.resource.data.postId is string
                  && request.resource.data.postId.size() > 0
                  && request.resource.data.reason is string
                  && request.resource.data.reason.size() <= 40
                  && request.resource.data.note is string
                  && request.resource.data.note.size() <= 500
                  && request.resource.data.status == 'open';

      // A reader may refile (same doc id) while it is still open, which is
      // how changing the reason works; they may not reopen or re-word one a
      // moderator has already acted on.
      allow update: if isModerator()
                  || (request.auth != null
                      && resource.data.reporterUid == request.auth.uid
                      && resource.data.status == 'open'
                      && request.resource.data.reporterUid == request.auth.uid
                      && request.resource.data.postId == resource.data.postId
                      && request.resource.data.status == 'open');

      allow delete: if isModerator();
    }

    // Everything else stays fully locked until a later phase explicitly
    // opens it up.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
