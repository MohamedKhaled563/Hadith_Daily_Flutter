rules_version = '2';

// Phase 1: deny-by-default, plus read-only access to the two collections
// that phase 2 (content migration) populated. Nothing here lets a client
// write anything to them — hadiths/dailyMessages are written only by the
// admin import scripts, which use the Admin SDK and therefore never go
// through these rules at all.
//
// Phase 4 adds users/ below and moderator/admin clauses on
// communityMessages. Phase 5 adds settings/ (the delivery-mode toggle) and
// a narrow timesShown/lastShownAt update on dailyMessages' and
// communityMessages' pool entries — see the daily delivery engine
// (DailyTipService). Phase 6 lets a moderator/admin — from the dashboard,
// using the ordinary client SDK — edit dailyMessages (e.g. `order`) and
// flip settings/deliveryMode; both were client SDK-write:false before,
// since nothing needed to write them yet. A real per-user likes
// subcollection still arrives in phase 7 — the interim likeCount
// mechanism from phase 3 is unchanged.
service cloud.firestore {
  match /databases/{database}/documents {

    match /hadiths/{hadithId} {
      allow read: if true;
      allow write: if false;
    }

    // Two different writers are allowed here, so this is an OR:
    //   1. a moderator/admin (the dashboard), changing anything
    //   2. ANY signed-in device that just picked this as its own daily
    //      tip, but only ever moving `timesShown` up by exactly one and
    //      stamping `lastShownAt` — phase 5's delivery engine.
    match /dailyMessages/{messageId} {
      allow read: if true;
      allow update: if request.auth.token.role in ['moderator', 'admin']
                  || (request.auth != null
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['timesShown', 'lastShownAt'])
                      && request.resource.data.timesShown
                           == resource.data.get('timesShown', 0) + 1);
      allow create, delete: if false;
    }

    // Public read; a moderator/admin (the dashboard's mode toggle) is the
    // only client allowed to write it, alongside tool/set_delivery_mode.py
    // via the Admin SDK for anyone without dashboard access handy.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth.token.role in ['moderator', 'admin'];
    }

    // Phase 4: one doc per signed-in user, id = their uid. `role` is never
    // set by the client — only tool/set_role.py, via the Admin SDK, ever
    // writes it, which is why the create/update rules below never even
    // mention that field: a client literally cannot include it in a write
    // this rule accepts.
    match /users/{uid} {
      allow read: if request.auth.uid == uid
                  || request.auth.token.role in ['moderator', 'admin'];

      allow create: if request.auth.uid == uid
                  && request.resource.data.keys().hasOnly(
                       ['displayName', 'email', 'createdAt']);

      allow update: if request.auth.uid == uid
                  && request.resource.data.diff(resource.data)
                       .affectedKeys().hasOnly(['displayName']);
    }

    match /communityMessages/{messageId} {
      // Public once approved; the author can always see their own
      // (including while still pending); moderators/admins can see
      // everything, which is what makes the pending queue possible.
      allow read: if resource.data.status == 'approved'
                  || request.auth.uid == resource.data.authorUid
                  || request.auth.token.role in ['moderator', 'admin'];

      // Must be signed in (this app has no anonymous path at all), must
      // claim authorship truthfully, and can only ever be created pending —
      // a client cannot create a message that's already approved.
      allow create: if request.auth != null
                  && request.resource.data.authorUid == request.auth.uid
                  && request.resource.data.status == 'pending'
                  && request.resource.data.likeCount == 0;

      // Four unrelated things are allowed to update a message, so this is
      // an OR of four independent conditions:
      //   1. the author, editing their own still-pending submission
      //   2. a moderator/admin, changing anything — this is the approve/
      //      reject/edit action; no field restriction, since a moderator is
      //      trusted the way the app's own client code isn't
      //   3. ANY signed-in reader, but only ever moving `likeCount` by
      //      exactly one in either direction — the interim like counter
      //      from phase 3, unchanged; phase 7 replaces it properly.
      //   4. ANY signed-in device, but only ever moving `timesShown` up by
      //      exactly one and stamping `lastShownAt` — phase 5's delivery
      //      engine, only ever applies to an approved message since that's
      //      the only status the pool draws from.
      allow update: if (request.auth.uid == resource.data.authorUid
                        && resource.data.status == 'pending')
                  || (request.auth.token.role in ['moderator', 'admin'])
                  || (request.auth != null
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['likeCount'])
                      && (request.resource.data.likeCount
                            == resource.data.likeCount + 1
                          || request.resource.data.likeCount
                            == resource.data.likeCount - 1))
                  || (request.auth != null
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['timesShown', 'lastShownAt'])
                      && request.resource.data.timesShown
                           == resource.data.get('timesShown', 0) + 1);

      allow delete: if (request.auth.uid == resource.data.authorUid
                        && resource.data.status == 'pending')
                  || request.auth.token.role in ['moderator', 'admin'];
    }

    // Everything else stays fully locked until a later phase explicitly
    // opens it up.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
