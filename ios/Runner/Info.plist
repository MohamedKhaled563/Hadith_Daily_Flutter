<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>طيّب قلبك</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>tayebqalbak</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- REVERSED_CLIENT_ID from GoogleService-Info.plist, required
				     so Google Sign-In can redirect back into the app. -->
				<string>com.googleusercontent.apps.305295927502-4bqfmmrh77fbmjk4mqgd1b5fai0q2hnl</string>
			</array>
		</dict>
	</array>
	<!-- The share sheet's "Save Image" action writes the rendered message
	     card to Photos from this app's own process, so iOS terminates the app
	     the instant it is tapped without this key. See ShareService. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>لحفظ بطاقة الرسالة في مكتبة الصور عند اختيارك «حفظ الصورة» من قائمة المشاركة.</string>
	<!-- file_picker's native code links into this binary even though only the
	     dashboard entrypoint (lib/main_dashboard.dart) calls it, because plugin
	     registration is per-project rather than per-entrypoint. App Store
	     Connect's upload scan rejects a binary carrying photo-library symbols
	     with no purpose string (ITMS-90683), so the string is required even
	     though the phone app never opens the photo library. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>لاختيار ملف من جهازك عند استيراد الرسائل اليومية. لا يستخدم التطبيق صورك لأي غرض آخر.</string>
	<!-- The app uses only HTTPS and the platform's own crypto, which is the
	     exempt case. Without this key App Store Connect asks the export
	     compliance question on every upload, TestFlight builds included. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- The UI is Arabic-only (main.dart pins locale: Locale('ar')), but
	     CFBundleDevelopmentRegion resolves to $(DEVELOPMENT_LANGUAGE) = en, so
	     without this iOS renders its own dialogs in English inside an Arabic,
	     right-to-left app. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>ar</string>
		<string>en</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
