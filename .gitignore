# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Gradle build cache
android/.gradle/

# Build output artifacts
/dist/

# Firebase Admin SDK service account keys — never commit these.
# tool/ scripts that need one read it from here.
/secrets/

# Firebase CLI deploy cache — regenerated by every `firebase deploy`.
/.firebase/

# Screenshots pulled off a device/emulator while checking a change by hand.
# Kept locally so they can be diffed against the next run; far too heavy to
# carry in history.
/.qa_screens/

# Android release signing. The keystore IS the app's identity on Play: lose it
# and you can never update this listing again, leak it and someone else can
# publish as you. Keep both the key and its passwords out of the repo, and
# back the .jks up somewhere that is not this machine.
/android/key.properties
*.jks
*.keystore
