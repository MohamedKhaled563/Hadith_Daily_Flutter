# Not secrets: the Gmail address the codes are sent from, and the day the
# unverified-account cleanup starts counting from. The Gmail app password and
# the code pepper live in Secret Manager (firebase functions:secrets:set).
MAIL_USER=tayebkalbak@gmail.com

# Accounts created on or after this date (ISO 8601) and still unverified
# seven days later are deleted every night. Empty = the cleanup does nothing.
# Set it to the day the app version with the code screen goes live, never
# earlier: older app versions have no way to enter a code. Set to 14 Nov 2026,
# before any store release, when only testers had older builds.
CLEANUP_CREATED_AFTER=2026-11-14T00:00:00Z
